# Telegram: token from @BotFather and the bot's username without @
BOT_TOKEN=123456:ABC-your-token
BOT_USERNAME=ponos13sm_bot

# Any long random string; Telegram sends it back with every webhook call
WEBHOOK_SECRET=change-me

# Any long random string; Vercel Cron sends it as "Authorization: Bearer ..."
CRON_SECRET=change-me-too

# Where the mini app lives (must be https for Telegram)
MINI_APP_URL=https://tubric.tech/app/

# Postgres. On Vercel this comes from the Neon integration automatically.
DATABASE_URL=postgresql://postgres:secret@localhost:5432/pet_together
